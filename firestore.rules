rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.balance is number &&
             data.vipLevel is string && data.vipLevel.size() <= 32 &&
             data.vipPoints is number &&
             data.totalSpins is number &&
             data.totalWon is number &&
             data.biggestWin is number &&
             data.isVip is bool &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10));
    }

    function isValidTransaction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.type is string && (data.type == 'deposit' || data.type == 'withdraw' || data.type == 'bonus') &&
             data.amount is number &&
             data.currency is string && data.currency.size() <= 10 &&
             data.method is string && data.method.size() <= 128 &&
             data.status is string && data.status.size() <= 64 &&
             data.referenceId is string && data.referenceId.size() <= 128;
    }

    function isValidSpin(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.gameId is string && data.gameId.size() <= 64 &&
             data.gameName is string && data.gameName.size() <= 128 &&
             data.betAmount is number &&
             data.winAmount is number &&
             data.multiplier is number;
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.sender is string && data.sender.size() <= 128 &&
             data.avatar is string && data.avatar.size() <= 16 &&
             data.text is string && data.text.size() <= 500 &&
             (!('isSystem' in data) || data.isSystem is bool);
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.avatar is string && data.avatar.size() <= 16 &&
             data.vipLevel is string && data.vipLevel.size() <= 32 &&
             data.score is number &&
             data.biggestWin is number &&
             data.tournamentPoints is number;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming()) && incoming().userId == userId;
        allow update, delete: if false; // Immutable ledger
      }

      // Spins subcollection
      match /spins/{spinId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(spinId) && isValidSpin(incoming()) && incoming().userId == userId;
        allow update, delete: if false; // Immutable spin audit logs
      }
    }

    // Live public chat and big-win feed
    match /chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && isValidChatMessage(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Public VIP Leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidLeaderboardEntry(incoming()) && incoming().userId == userId;
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
